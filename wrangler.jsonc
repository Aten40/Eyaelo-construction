{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eyaelo-construction",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eyaelo-business-content",
      "database_id": "de24d3b7-14a5-403d-8d63-888c5d6bdca5"
    }
  ],
  "secrets": {
    "required": [
      "ADMIN_PASSWORD"
    ]
  }
}
