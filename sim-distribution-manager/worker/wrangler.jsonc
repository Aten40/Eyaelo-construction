{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eyaelo-sim-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ORIGIN": "https://eyaelo-sim-manager.martinelolu30.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eyaelo-sim-manager-db",
      "database_id": "298e568a-375a-4f0f-b4d9-842f631ec844"
    }
  ]
}
